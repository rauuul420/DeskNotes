<Window x:Class="DeskNotes.App.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskNotes - Nueva nota"
        Width="760"
        Height="600"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#10131A"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#293044"/>
            <Setter Property="Foreground" Value="#E9ECF5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock x:Name="NoteTitleText" Text="Nueva nota" Foreground="#F4F5FA" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="TXT · MARKDOWN" Foreground="#858EA3" FontSize="10" FontWeight="SemiBold" Margin="1,3,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="AlwaysOnTopCheckBox"
                          Content="Siempre visible"
                          Foreground="#C6CBDA"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"
                          Click="AlwaysOnTopCheckBox_Click"/>
                <Button Content="Guardar como" Style="{StaticResource ToolbarButton}" Click="SaveAsButton_Click" Margin="0,0,8,0"/>
                <Button Content="Guardar" Style="{StaticResource ToolbarButton}" Click="SaveButton_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#191E29" CornerRadius="10" Padding="14">
            <TextBox x:Name="EditorTextBox"
                     TextChanged="EditorTextBox_TextChanged"
                     Background="Transparent"
                     Foreground="#E9ECF5"
                     CaretBrush="#AAB4FF"
                     SelectionBrush="#5364C8"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="14"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="True"/>
        </Border>

        <DockPanel Grid.Row="2" Margin="2,12,2,0">
            <TextBlock x:Name="StatusText" Text="Sin guardar" Foreground="#858EA3" FontSize="11" DockPanel.Dock="Left"/>
            <TextBlock Text="Ctrl + S · Ctrl + Mayús + S para guardar como" Foreground="#687286" FontSize="11" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
