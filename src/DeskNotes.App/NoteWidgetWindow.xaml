<Window x:Class="DeskNotes.App.NoteWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskNotes Widget"
        Width="320"
        Height="240"
        MinWidth="220"
        MinHeight="150"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="WidgetWindow_Loaded"
        Closing="WidgetWindow_Closing">
    <Window.Resources>
        <Style x:Key="WidgetButton" TargetType="Button">
            <Setter Property="Background" Value="#293044"/>
            <Setter Property="Foreground" Value="#E9ECF5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A4561"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F0191E29"
            BorderBrush="#35405A"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="DESKNOTES" Foreground="#929DB5" FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
                    <TextBlock x:Name="WidgetTitleText"
                               Text="Mi nota"
                               Foreground="#F4F5FA"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PinButton" Content="◇" ToolTip="Mantener encima de otras ventanas"
                            Style="{StaticResource WidgetButton}" Click="PinButton_Click" Margin="0,0,5,0"/>
                    <Button Content="Editar" Style="{StaticResource WidgetButton}" Click="EditButton_Click" Margin="0,0,5,0"/>
                    <Button Content="×" ToolTip="Cerrar widget" Style="{StaticResource WidgetButton}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#202633" CornerRadius="9" Padding="11">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="WidgetContentText"
                               Text="El contenido de tu nota aparecerá aquí."
                               Foreground="#DCE1ED"
                               FontSize="13"
                               TextWrapping="Wrap"
                               LineHeight="19"/>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="Doble clic para editar"
                       Foreground="#77839B"
                       FontSize="10"
                       HorizontalAlignment="Right"
                       Margin="0,9,2,0"/>
        </Grid>
    </Border>
</Window>
