<Window x:Class="DeskNotes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskNotes"
        Width="1080"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#10131A"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6D7CFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#252B38"/>
            <Setter Property="Foreground" Value="#E7EAF2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,34">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="DeskNotes" Foreground="#F4F5FA" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Tus ideas, siempre a mano." Foreground="#9299AA" FontSize="13" Margin="1,5,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Abrir archivo" Style="{StaticResource SecondaryButton}" Click="OpenNote_Click" Margin="0,0,10,0"/>
                <Button Content="+ Nueva nota" Style="{StaticResource PrimaryButton}" Click="NewNote_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#191E29" CornerRadius="16" Padding="34">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <Border Width="66" Height="66" CornerRadius="16" Background="#272F46" HorizontalAlignment="Center" Margin="0,0,0,22">
                        <TextBlock Text="✎" FontSize="32" Foreground="#AAB4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Un espacio para tus notas" Foreground="#F4F5FA" FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="Crea una nota nueva o abre un archivo TXT o Markdown que ya tengas. Cada documento se abrirá en su propia ventana y seguirá siendo un archivo normal de tu equipo."
                               Foreground="#A3AABD" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,26"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Crear una nota" Style="{StaticResource PrimaryButton}" Click="NewNote_Click" Margin="0,0,10,0"/>
                        <Button Content="Abrir TXT o MD" Style="{StaticResource SecondaryButton}" Click="OpenNote_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Los documentos permanecen en las ubicaciones que tú elijas."
                   Foreground="#747D90" FontSize="12" HorizontalAlignment="Center" Margin="0,20,0,0"/>
    </Grid>
</Window>
