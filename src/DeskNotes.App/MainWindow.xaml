
<Window x:Class="DeskNotes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskNotes"
        Width="1080"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#10131A"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6D7CFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#252B38"/>
            <Setter Property="Foreground" Value="#E7EAF2"/>
        </Style>

        <Style x:Key="LibraryItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E9ECF5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#252D40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Contenedor principal: permite intercambiar las dos vistas -->
    <Grid Margin="34">

        <!-- VISTA 1: GESTOR DE NOTAS -->
        <Grid x:Name="NotesView">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <DockPanel Grid.Row="0"
                       LastChildFill="False"
                       Margin="0,0,0,26">

                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="DeskNotes"
                               Foreground="#F4F5FA"
                               FontSize="28"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Tus ideas, siempre a mano."
                               Foreground="#9299AA"
                               FontSize="13"
                               Margin="1,5,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="Abrir archivo"
                            Style="{StaticResource SecondaryButton}"
                            Click="OpenNote_Click"
                            Margin="0,0,10,0"/>

                    <Button Content="+ Nueva nota"
                            Style="{StaticResource PrimaryButton}"
                            Click="NewNote_Click"/>

                    <Button Content="Ajustes"
                            Style="{StaticResource SecondaryButton}"
                            Click="OpenSettings_Click"
                            Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Biblioteca de notas -->
            <Border Grid.Row="1"
                    Background="#191E29"
                    CornerRadius="16"
                    Padding="24">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="2,0,2,16">
                        <TextBlock Text="Mis notas"
                                   Foreground="#F4F5FA"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Tus archivos guardados permanecen aquí aunque cierres sus ventanas."
                                   Foreground="#9299AA"
                                   FontSize="12"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="EmptyLibraryText"
                               Grid.Row="1"
                               Text="Todavía no tienes notas guardadas. Crea una nota o abre un archivo TXT o MD para añadirlo aquí."
                               Foreground="#747D90"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="420"
                               Margin="20"/>

                    <ListBox x:Name="SavedNotesList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Style="{StaticResource LibraryItemButton}"
                                            Tag="{Binding FilePath}"
                                            Click="SavedNote_Click">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="▤"
                                                       FontSize="21"
                                                       Foreground="#AAB4FF"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">

                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#E9ECF5"/>

                                                <TextBlock Text="{Binding FilePath}"
                                                           FontSize="11"
                                                           Foreground="#858EA3"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Content="Widget"
                                            Tag="{Binding FilePath}"
                                            Click="CreateWidget_Click"
                                            Background="#293044"
                                            Foreground="#E9ECF5"
                                            BorderThickness="0"
                                            Padding="12,8"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0"/>

                                    <Button Grid.Column="2"
                                            Content="Quitar"
                                            Tag="{Binding FilePath}"
                                            Click="RemoveSavedNote_Click"
                                            Background="Transparent"
                                            Foreground="#9299AA"
                                            BorderThickness="0"
                                            Padding="12,8"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Pie de página -->
            <TextBlock Grid.Row="2"
                       Text="Los archivos originales nunca se eliminan al quitar una nota de esta lista."
                       Foreground="#747D90"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,18,0,0"/>

        </Grid>

        <!-- VISTA 2: AJUSTES -->
        <Grid x:Name="SettingsView"
              Visibility="Collapsed">

            <StackPanel Margin="0,76,0,0" MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Text="Ajustes" Foreground="#F4F5FA" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Personaliza el comportamiento de DeskNotes." Foreground="#9299AA" FontSize="13" Margin="0,0,0,28"/>
                <Border Background="#191E29" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Guardado automático" Foreground="#F4F5FA" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Guarda las notas existentes después de un periodo sin escribir. Las notas nuevas sin guardar seguirán requiriendo que elijas dónde guardarlas." Foreground="#9299AA" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,16"/>
                        <CheckBox x:Name="AutoSaveCheckBox" Content="Activar guardado automático" Foreground="#E9ECF5" FontSize="13" Checked="AutoSaveEnabled_Changed" Unchecked="AutoSaveEnabled_Changed"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,18,0,0">
                            <TextBlock Text="Guardar tras" Foreground="#E9ECF5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ComboBox x:Name="AutoSaveIntervalComboBox" Width="150" SelectedIndex="1" SelectionChanged="AutoSaveInterval_SelectionChanged">
                                <ComboBoxItem Content="5 segundos" Tag="5"/>
                                <ComboBoxItem Content="10 segundos" Tag="10"/>
                                <ComboBoxItem Content="30 segundos" Tag="30"/>
                                <ComboBoxItem Content="1 minuto" Tag="60"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="El intervalo se cuenta desde la última modificación realizada en el editor." Foreground="#747D90" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Content="←"
                    Width="44"
                    Height="44"
                    FontSize="24"
                    Padding="0"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="BackToNotes_Click"/>

        </Grid>

    </Grid>
</Window>
